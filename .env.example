# ==============================================================================
# CONTEXTA - Environment Variables Configuration Template
# ==============================================================================
# NOTE: All keys in Contexta can also be configured and encrypted directly in the UI
# via the Settings modal (stored securely in browser localStorage using AES-GCM).
#
# If you prefer providing default keys during development, copy this file to:
#   .env.local
# DO NOT commit real API keys to version control!
# ==============================================================================

# OpenAI API Key (for GPT-4o, GPT-4o-mini, o1 models)
# https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Anthropic API Key (for Claude 3.5 Sonnet, Claude 3 Opus, Claude 3 Haiku)
# https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=

# Google Gemini API Key (for Gemini 1.5 Pro, Gemini 1.5 Flash, Gemini 2.0)
# https://aistudio.google.com/app/apikey
VITE_GOOGLE_API_KEY=

# Local Ollama Server URL (Optional - defaults to http://localhost:11434)
# https://ollama.ai/
VITE_OLLAMA_BASE_URL=http://localhost:11434
